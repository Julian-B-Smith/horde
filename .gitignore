# harness runtime state
.harness/
.claude/settings.local.json

# macOS
.DS_Store

# build outputs (Phase 0+; Debug and Release are separate dirs on this machine)
# build-*/ also covers build-golden/ — goldens are generated artifacts, only
# the generator is committed (ROADMAP Phase 1)
build/
build-*/

# local-only alias map for private siblings (ADR-014)
PRIVATE-NOTES.md

# FOUNDATIONS' conformance headers, vendored locally and NEVER committed: this
# repo is public and theirs is private, so tracking them would publish a private
# sibling's source (human ruling 2026-08-15). Our ADAPTER over them is ours and
# IS tracked (tools/conformance_check.cpp) — only their code is excluded. The
# gate degrades visibly: ./verify prints SKIPPED when these are absent, which is
# what public CI will always see.
libs/vendor/foundations/

# Quantum Morph specs + demo — reference a private sibling by real name; kept
# local-only until aliased (relocated from repo root 2026-07-22; ROADMAP tracks
# the plan). Un-ignore once the private names are aliased for tracking.
docs/proposals/QM-*.md
docs/design/quantum-morph-lab.html

# prebuilt bench binary — rebuilt on demand, not tracked
dist/cpu_bench

# private-sibling real names for the leak gate — never tracked (ADR-014)
.leakcheck-names

# python bytecode — a stray .pyc rode in on a GUI commit 2026-08-18
__pycache__/
*.pyc

# SCALPEL golden renders (reference/scalpel/verify/render-goldens.js) — ~45 MB of
# float WAVs, regenerated on demand, never tracked (the packet says so itself).
reference/scalpel/verify/goldens/
