     //==============================================================================
+    // Only registered when options.allowNavigation is set. Page and frame navigations
+    // arrive through the same handler interface, so each event gets its own filter,
+    // which knows the kind of request it reports.
+    struct NavigationFilter  : public ICoreWebView2NavigationStartingEventHandler,
+                               public ICoreWebView2NewWindowRequestedEventHandler
+    {
+        NavigationFilter (Pimpl& p, Options::NavigationType t)
+            : ownerPimpl (p), type (t), deletionCheckerRef (p.deletionChecker) {}
+
+        virtual ~NavigationFilter() {}
+
+        HRESULT STDMETHODCALLTYPE QueryInterface (REFIID, LPVOID*) override   { return E_NOINTERFACE; }
+        ULONG STDMETHODCALLTYPE AddRef() override     { return ++refCount; }
+        ULONG STDMETHODCALLTYPE Release() override    { auto newCount = --refCount; if (newCount == 0) delete this; return newCount; }
+
+        HRESULT STDMETHODCALLTYPE Invoke (ICoreWebView2*, ICoreWebView2NavigationStartingEventArgs* args) override
+        {
+            LPWSTR uri = {};
+            args->get_Uri (std::addressof (uri));
+
+            if (! allows (type, takeUTF8 (uri)))
+                args->put_Cancel (TRUE);
+
+            return S_OK;
+        }
+
+        HRESULT STDMETHODCALLTYPE Invoke (ICoreWebView2*, ICoreWebView2NewWindowRequestedEventArgs* args) override
+        {
+            LPWSTR uri = {};
+            args->get_Uri (std::addressof (uri));
+
+            if (! allows (Options::NavigationType::newWindow, takeUTF8 (uri)))
+                args->put_Handled (TRUE);  // handled, with no new window given: none opens
+
+            return S_OK;
+        }
+
+        bool allows (Options::NavigationType t, const std::string& uri) const
+        {
+            return ! deletionCheckerRef->deleted && ownerPimpl.options.allowNavigation (t, uri);
+        }
+
+        Pimpl& ownerPimpl;
+        const Options::NavigationType type;
+        std::atomic<ULONG> refCount { 0 };
+        std::shared_ptr<DeletionChecker> deletionCheckerRef;
+    };
+
+    void addNavigationFilters (ICoreWebView2* view)
+    {
+        COMPtr<NavigationFilter> pageFilter (new NavigationFilter (*this, Options::NavigationType::page));
+        COMPtr<NavigationFilter> frameFilter (new NavigationFilter (*this, Options::NavigationType::frame));
+        ICoreWebView2NavigationStartingEventHandler* pageHandler = pageFilter.object;
+        ICoreWebView2NavigationStartingEventHandler* frameHandler = frameFilter.object;
+        ICoreWebView2NewWindowRequestedEventHandler* newWindowHandler = pageFilter.object;
+
+        EventRegistrationToken token;
+        view->add_NavigationStarting (pageHandler, std::addressof (token));
+        view->add_FrameNavigationStarting (frameHandler, std::addressof (token));
+        view->add_NewWindowRequested (newWindowHandler, std::addressof (token));
+    }
+
+    // Converts a string that WebView2 allocated, and frees it.
+    static std::string takeUTF8 (LPWSTR s)
+    {
+        if (s == nullptr)
+            return {};
+
+        auto result = createUTF8FromUTF16 (s);
+        CoTaskMemFree (s);
+        return result;
+    }
+
+    //==============================================================================
     struct ExecuteScriptCompletedCallback  : public ICoreWebView2ExecuteScriptCompletedHandler
     {
         ExecuteScriptCompletedCallback (CompletionHandler&& cb) : callback (std::move (cb)) {}
