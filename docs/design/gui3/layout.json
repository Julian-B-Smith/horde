    {
      "id": "echo",
      "name": "Echo",
      "format": "echo-params",
      "target": "rack",
      "file": "vendor/echo.params.json",
      "lock": "vendor/echo.manifest.lock.json",
      "why": "spec/params.json is Echo's declared manifest (its schema line: 'the B439 / RS-2.1 manifest': ranges, defaults, laws, labels); core/manifest.lock.json freezes the same keys' identity without ranges, so it is vendored too and the generator checks the two list the same keys."
