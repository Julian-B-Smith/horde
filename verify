#!/usr/bin/env bash
# verify — oracle dispatcher. The harness's only interface to project QC.
# Usage: ./verify fast | full | report
# Contract: exit 0 = green, nonzero = red. Writes .harness/last-verify.json.
set -uo pipefail

TARGET="${1:-fast}"
HARNESS_DIR=".harness"
mkdir -p "$HARNESS_DIR"

# Kit-owned gates: record, leak_gate, kit_integrity. A repo missing this file
# is not a lesser repo, it is an UNGATED one, so failing loudly beats degrading
# quietly — a silently skipped privacy gate is exactly the shape of bug the
# gate exists to prevent.
if [ -r .kit/kit-gates.sh ]; then
  . .kit/kit-gates.sh
else
  echo "verify: .kit/kit-gates.sh missing — run kit_sync.py (gates cannot be skipped)" >&2
  exit 1
fi

# M_PI is a POSIX extension, NOT standard C++: MSVC does not define it without
# _USE_MATH_DEFINES, so it compiles everywhere the authors work and fails only on
# the Windows leg of CI. That is a 3-minute round trip to learn something a local
# grep answers instantly, and it has now bitten three times despite the lesson
# being written down in six files. Prose was not the missing piece; enforcement
# was. --untracked is load-bearing here for the same reason as in leak_gate: git
# grep skips new files otherwise, and a brand-new tool file is exactly the case.
portability_gate() {
  local hits
  hits=$(git grep --untracked -nI 'M_PI' -- '*.cpp' '*.h' '*.hpp' 2>/dev/null \
         | grep -vE '(//|/\*|\*).*M_PI' || true)
  [ -z "$hits" ] && return 0
  echo "verify: PORTABILITY — M_PI is undefined under MSVC; use a local kPi constant:" >&2
  echo "$hits" | sed 's/^/    /' >&2
  return 1
}

# PROJECT-OWNED GATE (not kit-owned; never move this into .kit/).
# Private-sibling real names in tracked files — ADR-014. This lived INSIDE the
# kit's leak_gate() until 2026-08-18, so the 2.4.0 vendoring migration removed it
# along with that function. It was never kit-owned: the alias rule is HYPERSAW
# substance, and the kit gate's business is identity PATHS, not our
# correspondents' names. Restored here, where it belongs — the misplacement is
# what the migration usefully exposed.
# The names live in .leakcheck-names, UNTRACKED, so this tracked gate never
# contains the thing it forbids. CI has no such file and says SKIPPED rather than
# pretending it ran (same idiom as conformance_check).
private_name_gate() {
  if [ ! -f .leakcheck-names ]; then
    echo "verify: .leakcheck-names absent — private-name leak check SKIPPED (expected off this Mac)" >&2
    return 0
  fi
  local pat hits
  pat=$(grep -vE '^[[:space:]]*(#|$)' .leakcheck-names | paste -sd'|' -)
  [ -n "$pat" ] || return 0
  # Case-SENSITIVE by design: a case-insensitive first draft tripped on ordinary
  # prose ("re-strikes in place"). -P for alternation.
  hits=$(git grep --untracked -nIP "($pat)" -- . \
           ':(exclude)PRIVATE-NOTES.md' ':(exclude).leakcheck-names' 2>/dev/null || true)
  [ -n "$hits" ] || return 0
  echo "verify: LEAK — a private sibling's real name in a tracked file (alias it; map in PRIVATE-NOTES.md):" >&2
  echo "$hits" | sed 's/^/    /' >&2
  return 1
}

fast() {
  # ---- Layer-0: seconds, not minutes. CI-blocking. -------------------------
  # Honestly-scoped day-zero oracle: structure + manifest sanity. The real L0
  # suite (L0-1 parity vs JS reference, L0-2..13 trajectories — specs/ACCEPTANCE.md)
  # lands in Phase 1 and REPLACES nothing here; it adds. Never weaken without
  # a human decision recorded in ROADMAP.md.
  local ok=0
  kit_integrity || ok=1   # kit-owned files match .kit/MANIFEST
  leak_gate || ok=1          # privacy gate: kit-core, keep it first
  private_name_gate || ok=1  # privacy gate: OURS (ADR-014 alias rule)

  # OUTBOUND FILINGS ACTUALLY REACHED THE READER. Three forms of one failure in a
  # single day (uncommitted / side-branch / committed-but-never-pushed) stranded
  # an ack FOUNDATIONS was waiting seven hours for. Every form was silent from
  # both ends, so care cannot fix it — only a check can. Reads only; never writes
  # to a sibling, and no-ops where none is checked out (their R9 is the rule).
  python3 tools/mailbox_delivery_check.py || ok=1

  # PRESENTATION TABLE is total, address-keyed, and honest about its gaps. The
  # MVP generates ~75 gui2 controls from this table, so a missing row is a
  # control that silently never appears — the 29-dead-controls failure with the
  # arrow reversed, invisible to every audio oracle either way.
  python3 tools/presentation_check.py || ok=1
  # ADR-108: the dependency graph must stay well-formed and its generated
  # header current. Structure and staleness only — whether a declared
  # dependency is CORRECT is a human act (see the tool's own docstring).
  python3 tools/depends_check.py || ok=1

  # GENERATED CONTROLS ARE CURRENT. gui2's controls are generated FROM the
  # presentation table, so an edited table with stale markup shows yesterday's
  # declarations — invisible to every audio oracle, which is why it is gated.
  python3 tools/gen_gui_controls.py --check || ok=1

  # THE TEST TABLE cannot claim coverage it lacks: every agentic row names a gate
  # this file actually runs (parsed from here, never a second list), and every
  # feature the GUI shows has at least one row. Both failure modes — an oracle
  # nobody wrote, a feature nobody tests — are silent by construction.
  python3 tools/test_table_check.py || ok=1
  portability_gate || ok=1   # MSVC-only breakage, caught locally not in CI

  # GUI REACHABILITY (L0023, third occurrence — the one that became a gate).
  # A param with no control anywhere ships fully implemented, fully tested,
  # host-automatable and ABSENT FROM THE PRODUCT, and no audio oracle can see it
  # because the audio path is correct. It has cost: FX types 0..5 with dropdowns
  # offering 0..3 for two weeks; a panic button missing from the shipping GUI;
  # and gui2 reaching 18 of 105 params while being someone's daily driver.
  # Gates the unambiguous case (unreachable EVERYWHERE); prints per-GUI coverage
  # so the renovation gap stays visible instead of forgotten again.
  python3 tools/gui_reach.py || ok=1

  # Structure: the canonical docs and the reference implementations exist.
  local f
  for f in specs/SPEC.md specs/ACCEPTANCE.md ROADMAP.md DECISIONS.md README.md CLAUDE.md \
           INDEX.md LIBRARY.md project.manifest.json \
           reference/swarmsaw.html reference/swarmspectra.html reference/swarmdynamics.html \
           reference/swarmfilter.html reference/swarmphaser.html reference/swarmtime.html specs/SPEC-EFFECTS.md \
           reference/swarmalator.html specs/SPEC-SWARMALATOR.md; do
    [ -f "$f" ] || { echo "verify: MISSING $f" >&2; ok=1; }
  done

  # Manifest parses and pins the essentials.
  python3 - << 'PY' || ok=1
import json, sys
m = json.load(open("project.manifest.json"))
s = m["survey"]
# RE-PINNED 2 -> 3 on the human's explicit ratification, 2026-08-15. This stays a
# HARDCODED pin rather than a softer "cites a ratification date" check: the whole
# point is that ANY drift fails, and a check that accepts a rung plus a plausible
# date would pass the drift it exists to catch. Raising this number is a human
# decision every time, and it caught the lead attempting exactly that.
assert s["architecture_rung"]["choice"] == 3, "rung drifted from ratified answer"
assert s["knowledge_loop_tags"], "knowledge-loop tags missing"
assert m["model_routing"]["lead"] == "opus", "model pin drifted"
PY

  # Knowledge loop integrity: every INDEX pointer resolves in LIBRARY.
  python3 - << 'PY' || ok=1
import re
idx = set(re.findall(r'\[(L\d{4})\]', open("INDEX.md").read()))
lib = set(re.findall(r'\[(L\d{4})\]', open("LIBRARY.md").read()))
missing = idx - lib
assert not missing, f"INDEX ids missing from LIBRARY: {missing}"
PY

  # Labs must SURVIVE LOADING (L0026, human-approved gate 2026-08-06). Five
  # times a lab shipped with a setup-time call reaching a `const` declared
  # further down; the browser swallows the throw, the rest of the script never
  # runs, and the page still looks fine — the mod lab's whole matrix was gone
  # for weeks that way. Executes each <script> under stub DOM globals, so what
  # surfaces is real JS (TDZ, typos), not missing-canvas noise. Calibrated
  # against both historical bugs re-injected; see the trace.
  if command -v node >/dev/null; then
    node tools/labharness/lab_load_check.mjs > /tmp/labload.$$ 2>&1 || {
      echo "verify: lab load check FAILED" >&2; cat /tmp/labload.$$ >&2; ok=1; }
    rm -f /tmp/labload.$$
  else
    echo "verify: node missing — lab load check SKIPPED" >&2
  fi

  return $ok
}

full() {
  fast || return $?
  # ---- Layer-E: the whole gate. Run before closing a queue item. -----------
  # Phase 0: the plugin builds cleanly (CI additionally runs pluginval on the
  # artifact every push; auval/host loads stay human-run — CLAUDE.md §Domain).
  # Phase 1+ adds golden parity renders + trajectory suite here.
  local build_dir
  build_dir="$(cd "$(dirname "$0")" && pwd)/build-release"
  if [ ! -d "$build_dir" ]; then
    cmake -S "$(dirname "$build_dir")" -B "$build_dir" -G "Unix Makefiles" \
      -DCMAKE_BUILD_TYPE=Release || return 1
  fi
  cmake --build "$build_dir" -j"$(sysctl -n hw.ncpu 2>/dev/null || echo 4)" || return 1

  # Phase 1 oracle chain: golden generator determinism -> fresh goldens ->
  # L0-1 parity (C++ vs JS reference, eps=1e-6) -> L0-2..5 + L0-13
  # trajectories. Goldens are regenerated every run so the JS reference in
  # reference/swarmsaw.html stays the live source of truth.
  command -v node >/dev/null || { echo "verify[full]: node required for golden self-check" >&2; return 1; }
  node tools/golden/gen_goldens.mjs --selfcheck || return 1
  node tools/golden/gen_goldens.mjs > /dev/null || return 1
  "$build_dir/parity_check" "$(dirname "$build_dir")/build-golden" || return 1
  "$build_dir/trajectory_check" || return 1
  "$build_dir/state_check" || return 1
  # Note-lifecycle guard (ADR-038): seeded note on/off streams must decay to
  # silence — the oracle for the 2026-07-18 "doesn't stop when you let go" hang.
  # Statically linked like state_check; no goldens. (Was built but ungated.)
  "$build_dir/notefuzz_check" || return 1

  # FORENSIC NOTE TRACE (FOUNDATIONS ask (c), 2026-08-11). The stuck-note bug
  # survived weeks because it could not be REPRODUCED — and a generator never
  # could have, since it emits the stream it imagines rather than the one the
  # host delivered. This gates the capture that turns the next field report into
  # a replayable case: the ring records every note event, wraps correctly, and
  # the voice table shows a gated voice (the view that would have shown the
  # orphan at a glance). Calibrated — dropping note_id and clamping the ring
  # index each make it FAIL. Known boundary: it does NOT cover panic dumping
  # BEFORE the state clear, which is prose at the panic site, not a gate.
  "$build_dir/trace_check" || return 1

  # WHICH VOICE DIES when the pool is full (FOUNDATIONS seam question 1,
  # 2026-08-11). notefuzz proves no voice HANGS — and proves it whether the
  # victim is the oldest, the newest, or random. Steal priority was entirely
  # unpinned, so a seam changing steal order would have left every gate green.
  # Pins all three alloc() tiers separately. Thresholds are MEASURED leakage
  # floors (a render where the note never sounded), not chosen numbers.
  # Calibrated: stealing the newest fails assertion 1; deleting tier 2 fails
  # assertion 2 with the held note dead at 0.005 and the released tail alive at
  # 0.091 — the exact musical harm the tier exists to prevent.
  "$build_dir/steal_check" || return 1

  # NOTE_END DELIVERY (L0022). Built and calibrated for the bug where
  # emitNoteEnds ignored try_push's return and destroyed an END forever under
  # output-buffer pressure — four rounds of wrong fixes before it was found.
  # It has been sitting OUTSIDE the gate set ever since, which is worse than
  # absent: a built, passing probe reads as coverage. Wired 2026-08-11.
  "$build_dir/endprobe" || return 1

  # COUPLING AXIS FOR NOTE LIFECYCLE (field report 2026-08-12). Every other
  # note-lifecycle oracle runs at ONE value of K — notefuzz never touches id 6 —
  # so the coupling axis was untested for lifecycle in an instrument whose whole
  # thesis IS the coupling. Covers K high before / during / after a note, in poly
  # and in mono+legato with oscillator 2 audible and envelopes diverged.
  # HONEST LIMIT, stated in the file: it delivers K as host in_events, and a GUI
  # knob instead goes through enqueueParam/drainQueue, which also floods the
  # host's OUTPUT buffer — L0022's mechanism. Green here does not clear that path.
  "$build_dir/kstuck_probe" || return 1

  # REAL-TIME SAFETY (2026-08-06): the audio thread must not allocate. The
  # charter has always said so; nothing enforced it, and an allocation in
  # process() is invisible to every other oracle because the AUDIO IS STILL
  # CORRECT — it only shows up as a click on someone else's machine. Counting
  # operator new/delete inside the process() window makes it deterministic.
  # Calibrated: a planted (non-elidable) allocation gives 320 hits and exit 1.
  "$build_dir/rtsafety_probe" || return 1

  # PARAMETER SCOPE (A12, 2026-08-11; ADR-089 conditions met). A GLOBAL core
  # param must reach EVERY oscillator, and a PER-OSC param must reach ONLY its
  # own. Neither assertion is meaningful alone: "fan everything to everything"
  # satisfies the first perfectly and destroys addressing, which is why the
  # second is the vacuity control.
  # Calibrated: reverting the global fan-out makes assertion 1 FAIL.
  # Every measurement builds a FRESH plugin instance — plug_reset() clears gates
  # but not parameter or core state, and this suite was order-dependent until it
  # did (0.955 s standalone vs 0.034 s after four unrelated renders).
  "$build_dir/paramscope_check" || return 1

  # SAMPLE-RATE INVARIANCE (ADR-009's rule, which nothing enforced until this
  # gate; added 2026-08-11 under ADR-089's delegation). Behaviour declared in
  # SECONDS must not track the sample rate. Named by FOUNDATIONS' F2 criterion
  # 1b, so it is externally load-bearing as well as ours.
  # Calibrated against the real regression, not a hypothetical: re-planting
  # ADR-086's fixed SAMPLE-COUNT grid gives 0.419% drift and FAILS; current is
  # 0.163% and passes, at a 0.3% tolerance chosen to sit between them. A 1%
  # tolerance would have passed the defect this exists for.
  "$build_dir/samplerate_check" || return 1

  # ROUTING MATRIX INVARIANTS (ADR-088). Guards a core that is NOT yet in the
  # audio path — deliberate, and the same posture glide and swarmalator hold:
  # the gate is what lets shell integration land on ground already proven.
  # Calibrated: removing the read-side acyclicity guard makes it FAIL.
  "$build_dir/routing_check" || return 1

  # NOTCH REACHABLE AS A RACK SLOT (parallel-streams round, stream A). NotchCore
  # itself was fully oracle-covered (notch_check, below) but unreachable from
  # the shipping FX rack — nothing in the product could ever select it. Drives
  # the real plugin through the CLAP factory: a slot set to Notch with a
  # non-zero amount must measurably change the output spectrum, WITH a
  # must-read-nothing control (Off must equal the no-slot case, bit-exact).
  # Calibrated: making the Notch case a no-op makes it FAIL — see the trace.
  "$build_dir/notchslot_check" || return 1
  # FX SLOT CONTRACT (approved 2026-08-15, "the rack owns dry/wet"). Every slot
  # keeps the promise it declares in fx_rack.h's kSlotContract. Three violations
  # are PINNED — Comp/Notch have no identity point, Comb changes level by 8.8 dB —
  # so the gate is green on "nothing NEW is broken" while the rack-side fix is
  # outstanding. A pin is a debt with a name; removing one is how the fix proves
  # itself. Negative-tested: a false identity declaration turns it red by slot.
  "$build_dir/slotcontract_check" || return 1

  # FOUNDATIONS NOTE-LIFECYCLE CONFORMANCE (their R5) — run against OUR tag
  # tables, plus our own END ledger. SKIPS BY DESIGN when the binary is absent:
  # their headers are vendored to a gitignored path because this repo is public
  # and theirs is private (human ruling 2026-08-15), so every CI runner lands
  # here. A skip that announces itself beats a gate that quietly is not a gate.
  if [ -x "$build_dir/conformance_check" ]; then
    "$build_dir/conformance_check" || return 1
  else
    echo "verify: FOUNDATIONS headers absent — conformance_check SKIPPED (expected off this Mac)" >&2
  fi

  # SUBDIVISION INVARIANCE (ADR-086, gate ratified 2026-08-10). Rendering must
  # not depend on how a buffer is split — a host may send 2048 frames or 33, and
  # the multi-oscillator mix splits further still. None of that is a musical
  # choice, so none of it may change a sample.
  # THIS IS THE PROPERTY NO GOLDEN CAN TEST: the generator and parity_check both
  # render at a FIXED block, so both sides share any subdivision bug and parity
  # agrees with itself. All 147 scenarios passed for the entire life of the
  # gravity bug and could not have failed. Reference oracles certify agreement;
  # this one certifies an invariant (L0031).
  # Calibrated: reverting the segmenting in swarm_core.h gives FAIL at 1.093.
  # Pan motion (ADR-064) is a KNOWN exclusion, printed loudly, pending its own
  # ruling — an undeclared exclusion is how a gate rots into decoration.
  "$build_dir/subdiv_check" || return 1

  # OSCILLATOR FAN-OUT (2026-08-09, gate ratified by the human same day): every
  # per-note and lifecycle operation must reach EVERY oscillator, not just the
  # one the `core` alias points at. Eight sites got this wrong and nothing
  # caught them — parity renders a single core, so a bend that split the
  # oscillator pair and an all-notes-off that left half the instrument gated
  # (a stuck note) were both invisible to every other chain here.
  # Drives the real CLAP event path and detects via emitted audio (Goertzel),
  # never a state read — a per-voice getter would test the accessor, which is
  # how state_check once agreed with itself through a broken one.
  # Calibrated: planted allOff gives a frozen plateau (decay x1.0), planted
  # tuning/retarget each strand ~50% of the energy at the old pitch.
  "$build_dir/mpe_check" || return 1

  # Oscillator preset tier (B20, 2026-08-06): the format is slot-AGNOSTIC and
  # globals never travel. Both are load-bearing — a preset that embedded its
  # origin slot would pass a naive round-trip and fail the first time anyone
  # copied oscillator 1 to 2, and one that carried the FX rack would silently
  # redecorate the patch it was dropped into.
  "$build_dir/preset_check" || return 1

  # Waveform-shape oracle (2026-08-01, human-gated): closed-form invariants at
  # K=0 — slope-sum bound, no up-jumps (never wrap-masked), no gradual falls,
  # linearity. Calibrated: clean saw passes, planted up-jump must fire.
  "$build_dir/waveshape_check" || return 1

  # Track E0 oracle chain: force goldens (extracted live from the effect
  # labs' HTMLs) -> force_check (seed-for-seed trajectories + the population
  # halves of L0-14/15/17/19/20).
  node tools/golden/gen_force_goldens.mjs --selfcheck || return 1
  node tools/golden/gen_force_goldens.mjs > /dev/null || return 1
  "$build_dir/force_check" "$(dirname "$build_dir")/build-golden/force" || return 1

  # Phase 4 oracle chain: SPECTRA goldens (JS reference live from
  # reference/swarmspectra.html) -> spectra_check (L0-1-style parity + L0-6/7).
  node tools/golden/gen_spectra_goldens.mjs --selfcheck || return 1
  node tools/golden/gen_spectra_goldens.mjs > /dev/null || return 1
  "$build_dir/spectra_check" "$(dirname "$build_dir")/build-golden/spectra" || return 1

  # Track E1 oracle chain: resonator-bank audio goldens (JS FilterLab live from
  # reference/swarmfilter.html, noise=0) -> filter_check (L0-1-style parity + L0-14).
  node tools/golden/gen_filter_goldens.mjs --selfcheck || return 1
  node tools/golden/gen_filter_goldens.mjs > /dev/null || return 1
  "$build_dir/filter_check" "$(dirname "$build_dir")/build-golden/filter" || return 1

  # Track E1.2 oracle chain: notch-swarm audio goldens (JS PhaserLab live from
  # reference/swarmphaser.html, noise=0) -> notch_check (L0-1-style parity + L0-16).
  node tools/golden/gen_notch_goldens.mjs --selfcheck || return 1
  node tools/golden/gen_notch_goldens.mjs > /dev/null || return 1
  "$build_dir/notch_check" "$(dirname "$build_dir")/build-golden/notch" || return 1

  # Swarmalator engine oracle: stereo goldens (JS Swarmalator live from
  # reference/swarmalator.html) -> swarmalator_check (L0-1 stereo parity + §5 anchors).
  node tools/golden/gen_swarmalator_goldens.mjs --selfcheck || return 1
  node tools/golden/gen_swarmalator_goldens.mjs > /dev/null || return 1
  "$build_dir/swarmalator_check" "$(dirname "$build_dir")/build-golden/swarmalator" || return 1

  # Travel-law oracle (A1 fold, ratified 2026-08-06): trajectory goldens from
  # bend-lab's Inertia (sliced live from the HTML) -> glide_check (parity at the
  # L0-1 bar + the behavioural anchors the roundup measured). The core is NOT in
  # the audio path yet — this gates the port so shell integration lands on
  # proven ground, the same order the swarmalator port used.
  node tools/golden/gen_glide_goldens.mjs --selfcheck || return 1
  node tools/golden/gen_glide_goldens.mjs > /dev/null || return 1
  "$build_dir/glide_check" "$(dirname "$build_dir")/build-golden/glide" || return 1

  # Track E2 time-engine oracle: echo+room goldens (JS TimeLab live from
  # reference/swarmtime.html, noise=0) -> time_check (L0-1 parity + L0-19/20/21).
  node tools/golden/gen_time_goldens.mjs --selfcheck || return 1
  node tools/golden/gen_time_goldens.mjs > /dev/null || return 1
  "$build_dir/time_check" "$(dirname "$build_dir")/build-golden/time" || return 1
}

case "$TARGET" in
  fast)   fast;  record fast  $? ;;
  full)   full;  record full  $? ;;
  report) cat "$HARNESS_DIR/last-verify.json" 2>/dev/null || { echo '{"target":null,"exit":null}'; exit 1; } ;;
  *)      echo "usage: ./verify fast|full|report" >&2; exit 64 ;;
esac
